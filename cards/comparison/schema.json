{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forma:card:comparison",
  "title": "Data Comparison",
  "description": "对比前后数据并由系统生成指标、文本、逐行差异、实体列表和图片对照；entity 模块直接展示调用方传入的实体列表。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1",
      "default": "1",
      "title": "Schema 版本"
    },
    "type": {
      "const": "comparison",
      "default": "comparison",
      "title": "Card 类型"
    },
    "title": {
      "type": "string",
      "default": "数据对比",
      "title": "主标题",
      "description": "卡片主标题，最多显示一行。"
    },
    "subtitle": {
      "type": "string",
      "title": "副标题",
      "description": "可选的卡片副标题，最多显示一行。"
    },
    "time": {
      "type": "string",
      "title": "时间",
      "description": "可选的对比时间或更新时间。"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "title": "对比模块",
      "description": "按顺序展示的指标、文本、差异、实体或图片模块。除 entity 列表外，调用方提供 before/after，派生差异由系统计算。",
      "items": {
        "type": "object",
        "title": "模块",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["metric", "text", "diff", "image", "entity"],
            "default": "metric",
            "title": "模块类型",
            "description": "metric 指标、text 文本、diff 逐行差异、image 图片对照、entity 实体列表变更。"
          },
          "name": {
            "type": "string",
            "title": "模块名称",
            "description": "可选的模块标题；省略或为空时不显示模块标题。"
          },
          "items": {
            "type": "array",
            "title": "项目列表",
            "description": "metric 模块传入前后数值；entity 模块传入实体、动作文案和颜色。",
            "items": {
              "type": "object",
              "title": "项目",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "title": "指标名称"
                },
                "before": {
                  "type": ["string", "number"],
                  "title": "变更前",
                  "default": ""
                },
                "after": {
                  "type": ["string", "number"],
                  "title": "变更后",
                  "default": ""
                },
                "name": {
                  "type": "string",
                  "title": "名称"
                },
                "handle": {
                  "type": "string",
                  "title": "账号"
                },
                "bio": {
                  "type": "string",
                  "title": "简介",
                  "x-forma-widget": "textarea"
                },
                "action": {
                  "type": "string",
                  "title": "动作文案",
                  "description": "直接显示在实体右侧的动作文案，例如 + 新增关注或 − 取消关注。"
                },
                "color": {
                  "type": "string",
                  "enum": ["green", "red", "gray"],
                  "default": "gray",
                  "title": "动作颜色"
                }
              }
            }
          },
          "before": {
            "type": ["string", "object"],
            "title": "变更前",
            "description": "text/diff 为文本；image 为图片对象。",
            "x-forma-widget": "textarea",
            "properties": {
              "url": {
                "type": "string",
                "title": "图片地址"
              },
              "label": {
                "type": "string",
                "title": "图片标签"
              }
            },
            "required": ["url"],
            "additionalProperties": false
          },
          "after": {
            "type": ["string", "object"],
            "title": "变更后",
            "description": "text/diff 为文本；image 为图片对象。",
            "x-forma-widget": "textarea",
            "properties": {
              "url": {
                "type": "string",
                "title": "图片地址"
              },
              "label": {
                "type": "string",
                "title": "图片标签"
              }
            },
            "required": ["url"],
            "additionalProperties": false
          }
        },
        "required": ["type"],
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "metric" } } },
            "then": {
              "required": ["items"],
              "properties": {
                "items": {
                  "items": { "required": ["before", "after"] }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": { "enum": ["text", "diff"] }
              }
            },
            "then": {
              "required": ["before", "after"],
              "properties": {
                "before": { "type": "string" },
                "after": { "type": "string" }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "image" } } },
            "then": {
              "required": ["before", "after"],
              "properties": {
                "before": {
                  "type": "object",
                  "required": ["url"]
                },
                "after": {
                  "type": "object",
                  "required": ["url"]
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "entity" } } },
            "then": {
              "required": ["items"],
              "properties": {
                "items": {
                  "items": { "required": ["name", "action"] }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": ["schemaVersion", "type", "title", "modules"]
}
