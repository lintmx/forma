{
  "name": "forma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.ts",
    "card:create": "node scripts/create-card.ts",
    "predev": "pnpm generate",
    "dev": "vite",
    "prebuild": "pnpm generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "check": "node scripts/generate.ts --check && pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "ajv": "^8.17.1",
