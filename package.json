{
  "name": "forma",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm fonts:fetch && pnpm emoji:fetch && tsx scripts/dev.ts",
    "build": "pnpm fonts:fetch && pnpm emoji:fetch && pnpm check && tsx scripts/build.ts && vite build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "biome check . && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/api.test.ts tests/templates.test.ts tests/asset-prefix.test.ts",
    "preview:typography": "tsx scripts/render-typography.ts",
    "fonts:verify": "tsx scripts/verify-fonts.ts",
    "fonts:fetch": "tsx scripts/fetch-fonts.ts",
    "emoji:fetch": "tsx scripts/fetch-emoji.ts",
    "emoji:verify": "tsx scripts/verify-emoji.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "diff": "9.0.0",
    "entities": "8.1.0",
    "h3": "2.0.2",
    "image-size": "2.0.4",
    "marked": "18.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.55.1",
    "sharp": "0.35.5",
    "skia-canvas": "4.0.0",
    "twitter-text": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/twitter-text": "3.1.10",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.28.1",
    "fflate": "0.8.3",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
