# pnpm dev/start load .env automatically; existing shell variables take precedence.
# Compose reads .env automatically.
PORT=3000
LOG_LEVEL=info
RENDER_CONCURRENCY=2
RENDER_QUEUE_LIMIT=16
RENDER_TIMEOUT_MS=15000
MAX_WIDTH=4096
MAX_HEIGHT=8192
MAX_PIXELS=8000000
IMAGE_TIMEOUT_MS=4000
IMAGE_MAX_BYTES=5242880
IMAGE_CACHE_BYTES=33554432
IMAGE_CACHE_TTL_MS=300000
# PLAYGROUND_ENABLED=true
# FONT_CONFIG=/absolute/path/fonts.json
# Compose host port (container listens on 3000)
FORMA_PORT=3000
FORMA_BIND=127.0.0.1
